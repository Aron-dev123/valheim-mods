<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Breitengrade</AssemblyName>
    <RootNamespace>Breitengrade</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Wir kompilieren direkt gegen die .NET-Bibliotheken, die Valheim mitbringt. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="netstandard" HintPath="$(ValheimManaged)\netstandard.dll" Private="false" />
    <Reference Include="mscorlib" HintPath="$(ValheimManaged)\mscorlib.dll" Private="false" />
    <Reference Include="System" HintPath="$(ValheimManaged)\System.dll" Private="false" />
    <Reference Include="System.Core" HintPath="$(ValheimManaged)\System.Core.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)\assembly_utils.dll" Private="false" />
    <Reference Include="SoftReferenceableAssets" HintPath="$(ValheimManaged)\SoftReferenceableAssets.dll" Private="false" />
    <Reference Include="Splatform" HintPath="$(ValheimManaged)\Splatform.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(ValheimManaged)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ValheimManaged)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
  </ItemGroup>

  <!-- Planetos-Biomkarte (erzeugt mit tools/PlanetosKarte/umwandeln.py) -->
  <ItemGroup>
    <EmbeddedResource Include="Planetos.biome.gz" LogicalName="Breitengrade.Planetos.biome.gz" />
  </ItemGroup>

  <!-- Nach jedem Build die fertige DLL direkt in den BepInEx-plugins-Ordner kopieren. -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPlugins)" />
    <Message Importance="high" Text="Kopiert nach $(BepInExPlugins)" />
  </Target>

</Project>
